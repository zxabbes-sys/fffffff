<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إلى ألطف وأحلى صديقة رقية ✨</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Tajawal', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #31103f 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
            color: #ffffff;
        }

        /* خلفية نجوم وفقاعات متحركة */
        .bg-bubbles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            overflow: hidden;
            pointer-events: none;
        }

        .bubble {
            position: absolute;
            bottom: -100px;
            background: rgba(168, 85, 247, 0.15);
            border-radius: 50%;
            opacity: 0.5;
            animation: rise 12s infinite ease-in-out;
        }

        @keyframes rise {
            0% { transform: translateY(0) scale(0.8); opacity: 0; }
            50% { opacity: 0.6; }
            100% { transform: translateY(-120vh) scale(1.2); opacity: 0; }
        }

        /* كارت العرض */
        .card-container {
            position: relative;
            z-index: 10;
            width: 90%;
            max-width: 440px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 30px;
            padding: 35px 25px;
            text-align: center;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(168, 85, 247, 0.25);
            transition: all 0.5s ease;
        }

        .avatar-box {
            position: relative;
            width: 110px;
            height: 110px;
            margin: 0 auto 20px;
        }

        .avatar-img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: linear-gradient(45deg, #8b5cf6, #ec4899);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 50px;
            box-shadow: 0 10px 25px rgba(139, 92, 246, 0.4);
            animation: pulseAvatar 2s infinite alternate;
        }

        @keyframes pulseAvatar {
            0% { transform: scale(1); box-shadow: 0 10px 25px rgba(139, 92, 246, 0.4); }
            100% { transform: scale(1.06); box-shadow: 0 15px 35px rgba(236, 72, 153, 0.6); }
        }

        .star-badge {
            position: absolute;
            bottom: 2px;
            right: 2px;
            background: #ffffff;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .step-content {
            min-height: 180px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .title {
            font-size: 24px;
            font-weight: 800;
            color: #f3e8ff;
            margin-bottom: 12px;
            text-shadow: 0 2px 10px rgba(168, 85, 247, 0.3);
        }

        .message {
            font-size: 17px;
            line-height: 1.7;
            color: #fce7f3;
            font-weight: 500;
            margin-bottom: 25px;
        }

        .btn-group {
            display: flex;
            gap: 12px;
            justify-content: center;
            width: 100%;
            flex-wrap: wrap;
        }

        .btn {
            background: linear-gradient(45deg, #a855f7, #ec4899);
            color: white;
            border: none;
            padding: 14px 28px;
            font-size: 16px;
            font-weight: 700;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(168, 85, 247, 0.3);
            transition: all 0.3s ease;
            width: 100%;
            max-width: 220px;
        }

        .btn:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 12px 25px rgba(168, 85, 247, 0.5);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.15);
            color: #f3e8ff;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .dots-container {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 25px;
        }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.25);
            transition: all 0.3s ease;
        }

        .dot.active {
            width: 24px;
            border-radius: 10px;
            background: #a855f7;
            box-shadow: 0 0 10px #a855f7;
        }

        .friend-counter {
            font-size: 38px;
            font-weight: 800;
            background: linear-gradient(45deg, #c084fc, #f472b6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin: 15px 0;
        }
    </style>
</head>
<body>

    <div class="bg-bubbles" id="bubbles"></div>

    <div class="card-container">
        <div class="avatar-box">
            <div class="avatar-img" id="avatarEmoji">🎀</div>
            <div class="star-badge">✨</div>
        </div>

        <div class="step-content" id="stepContent"></div>
        <div class="dots-container" id="dotsContainer"></div>
    </div>

    <script>
        const bubblesContainer = document.getElementById('bubbles');
        for (let i = 0; i < 15; i++) {
            const bubble = document.createElement('div');
            bubble.className = 'bubble';
            const size = Math.random() * 60 + 20;
            bubble.style.width = `${size}px`;
            bubble.style.height = `${size}px`;
            bubble.style.left = `${Math.random() * 100}%`;
            bubble.style.animationDuration = `${Math.random() * 8 + 6}s`;
            bubble.style.animationDelay = `${Math.random() * 4}s`;
            bubblesContainer.appendChild(bubble);
        }

        const steps = [
            {
                emoji: "🌸",
                title: "هلوو رقوشة ✨",
                message: "عندي رسالة بسيطة وخاصة إلكِ يا ألطف صديقة.. تتوقعين شنو هي؟ 🙈",
                btnText: "شنو هي؟ 🥺"
            },
            {
                emoji: "✨🌸",
                title: "لأحلى وأغلى رقوش..",
                message: "رباط الصداقة الحقيقية صدفة حلوة، ووجودك بحياتي ألطف وأجمل صدفة! يا بختي بصديقة حنونة وطيبة مثلك 👑",
                btnText: "التالي ✨"
            },
            {
                emoji: "😜🤍",
                title: "سؤال صريح رقوشة..",
                message: "تدرين أنكِ أكثر صديقة أختفي وياها وأفرح بوجودها وطيبتها؟ 🙈✨",
                btnText: "أكيد أدري! 😎",
                altBtnText: "صدك؟ 🥺"
            },
            {
                emoji: "🤍✨",
                title: "رقية الأخت والصديقة المميزة!",
                message: "ربي يديم المحبة والصداقة الطيبة وما يحرمنا من ضحكتك ولطافتك وحنيتك الدايمة 🌸👑",
                btnText: "شوف معزتك عندي 😍"
            },
            {
                emoji: "🎀👑",
                title: "نسبة معزة وغلاوة رقية عندي:",
                isFinal: true
            }
        ];

        let currentStep = 0;

        function renderDots() {
            const container = document.getElementById('dotsContainer');
            container.innerHTML = '';
            steps.forEach((_, idx) => {
                const dot = document.createElement('div');
                dot.className = `dot ${idx === currentStep ? 'active' : ''}`;
                container.appendChild(dot);
            });
        }

        function showStep(index) {
            const step = steps[index];
            const contentBox = document.getElementById('stepContent');
            const avatarEmoji = document.getElementById('avatarEmoji');

            avatarEmoji.textContent = step.emoji;

            if (step.isFinal) {
                contentBox.innerHTML = `
                    <div class="title">${step.title}</div>
                    <div class="friend-counter" id="counter">0%</div>
                    <div class="message" style="margin-bottom:15px;">أحلى وأغلى صديقة بالدنيا رقوشة 🌸✨</div>
                    <div class="btn-group">
                        <button class="btn" onclick="restart()">إعادة الرسالة 🔄</button>
                    </div>
                `;
                animateCounter();
            } else if (step.altBtnText) {
                contentBox.innerHTML = `
                    <div class="title">${step.title}</div>
                    <div class="message">${step.message}</div>
                    <div class="btn-group">
                        <button class="btn" onclick="nextStep()">${step.btnText}</button>
                        <button class="btn btn-secondary" onclick="nextStep()">${step.altBtnText}</button>
                    </div>
                `;
            } else {
                contentBox.innerHTML = `
                    <div class="title">${step.title}</div>
                    <div class="message">${step.message}</div>
                    <div class="btn-group">
                        <button class="btn" onclick="nextStep()">${step.btnText}</button>
                    </div>
                `;
            }
            renderDots();
        }

        function nextStep() {
            if (currentStep < steps.length - 1) {
                currentStep++;
                showStep(currentStep);
            }
        }

        function restart() {
            currentStep = 0;
            showStep(currentStep);
        }

        function animateCounter() {
            let count = 0;
            const target = 1000000;
            const counterEl = document.getElementById('counter');
            const timer = setInterval(() => {
                count += 25000;
                if (count >= target) {
                    counterEl.textContent = "1,000,000% ∞";
                    clearInterval(timer);
                } else {
                    counterEl.textContent = `${count.toLocaleString()}%`;
                }
            }, 30);
        }

        showStep(0);
    </script>
</body>
</html>
